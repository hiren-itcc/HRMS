// HRMS schema — docs/02-database.md is the design source for this file.
// Every tenant-owned table carries organizationId (multi-tenant-ready, ADR §1.3).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & Access ────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  roles          Role[]
  employees      Employee[]
  departments    Department[]
  designations   Designation[]
  locations      Location[]
  holidays       Holiday[]
  settings       Setting[]
  emailTemplates EmailTemplate[]

  payComponents    PayComponent[]
  salaryStructures SalaryStructure[]
  payrollRuns      PayrollRun[]

  letters         Letter[]
  letterTemplates LetterTemplate[]

  jobOpenings  JobOpening[]
  candidates   Candidate[]
  applications Application[]
  offers       Offer[]

  expenseCategories ExpenseCategory[]
  expenseClaims     ExpenseClaim[]

  reviewCycles       ReviewCycle[]
  performanceGoals   PerformanceGoal[]
  performanceReviews PerformanceReview[]

  employeeImports EmployeeImport[]
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id                 String     @id @default(cuid())
  organizationId     String
  email              String     @unique
  passwordHash       String
  status             UserStatus @default(INVITED)
  /// Set when an account is created with a shared default password. Login
  /// succeeds but the app sends them straight to change it, so a predictable
  /// credential is never a usable one for long.
  mustChangePassword Boolean    @default(false)
  /// Whether in-app notifications are also emailed to this person. The
  /// organization's own switch is `EmailTemplate.isActive` on
  /// `notification_generic`; this is the individual's, and either one being
  /// off is enough. Password resets and invites ignore both — see `required`
  /// in the email template catalogue.
  emailNotifications Boolean    @default(true)
  roleId             String
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  role         Role                 @relation(fields: [roleId], references: [id])
  employee     Employee?
  sessions     RefreshSession[]
  resetTokens  PasswordResetToken[]

  @@index([organizationId])
  @@index([roleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  isSystem       Boolean @default(false)

  organization Organization     @relation(fields: [organizationId], references: [id])
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique
  resource String
  action   String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Organization structure ───────────────────────────────────────────

model Department {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String?
  parentId       String?
  headId         String? @unique

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children     Department[] @relation("DeptTree")
  head         Employee?    @relation("DeptHead", fields: [headId], references: [id])
  employees    Employee[]

  jobOpenings JobOpening[]
  offers      Offer[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Designation {
  id             String @id @default(cuid())
  organizationId String
  title          String
  level          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  jobOpenings JobOpening[]
  offers      Offer[]

  @@unique([organizationId, title])
}

enum LocationType {
  HEAD_OFFICE
  BRANCH
  REMOTE
  CLIENT_SITE
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           LocationType @default(BRANCH)
  address        String?
  city           String?
  country        String?
  timezone       String?

  /// The geofence attendance checks an OFFICE claim against. Optional: a
  /// location without coordinates simply cannot verify anyone, which reads as
  /// "unverified" rather than as an accusation.
  latitude             Float?
  longitude            Float?
  geofenceRadiusMeters Int    @default(200)

  organization Organization        @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  holidays     Holiday[]
  sessions     AttendanceSession[]
  assets       Asset[]

  jobOpenings JobOpening[]
  offers      Offer[]

  @@unique([organizationId, name])
}

model EmploymentType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String?

  employees Employee[]

  jobOpenings JobOpening[]
  offers      Offer[]

  @@unique([organizationId, name])
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  date           DateTime @db.Date
  isOptional     Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])

  @@unique([organizationId, locationId, date, name])
  @@index([organizationId, date])
}

// ─── Employees ────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmployeeStatus {
  /// Invited or filling in their details; not yet an operational employee.
  /// Deliberately first so that "not yet started" sorts before "working".
  ONBOARDING
  ACTIVE
  ON_NOTICE
  EXITED
}

model Employee {
  id               String         @id @default(cuid())
  organizationId   String
  userId           String?        @unique
  employeeCode     String
  firstName        String
  lastName         String
  workEmail        String
  personalEmail    String?
  phone            String?
  dateOfBirth      DateTime?      @db.Date
  gender           Gender?
  /// The path that serves the photo — `/employees/<id>/avatar?v=<hash>`, not a
  /// public URL. The bucket is private (see `supabase.storage.ts`), so the
  /// bytes go through the API like every other file and the `v` token is what
  /// makes a replacement photo beat the browser cache.
  avatarUrl        String?
  /// The opaque storage key behind `avatarUrl`. Kept separately because
  /// replacing or removing a photo has to delete the previous object, and the
  /// served path cannot be turned back into a key.
  avatarKey        String?
  addressLine      String?
  city             String?
  country          String?
  departmentId     String?
  designationId    String?
  locationId       String?
  managerId        String?
  shiftId          String?
  employmentTypeId String?
  status           EmployeeStatus @default(ACTIVE)
  joinDate         DateTime       @db.Date
  exitDate         DateTime?      @db.Date

  /// Notice this person owes, in calendar days. Null = the organization
  /// default from Settings → Preferences. A per-person column rather than a
  /// column on EmploymentType because two full-time hires routinely differ.
  noticePeriodDays Int?

  /// Probation, kept off EmployeeStatus on purpose: somebody on probation is
  /// ACTIVE, and adding a status member would ripple into every
  /// `status: { notIn: [...] }` filter in attendance, payroll, reports and the
  /// directory. The dates are the mechanism; the badge is derived from them.
  ///
  /// `probationMonths` is null for the org default, and is read only when the
  /// end date is first computed — after that `probationEndDate` is what was
  /// agreed, and editing the company default must not silently re-date
  /// everybody who already joined.
  probationMonths     Int?
  probationEndDate    DateTime? @db.Date
  /// Set by an explicit extension. Supersedes `probationEndDate` without
  /// overwriting it, so "extended from 1 Sep to 1 Dec" stays answerable.
  probationExtendedTo DateTime? @db.Date
  /// Off probation for good. Set by HR or by the daily tick.
  confirmedOn         DateTime? @db.Date

  /// Remote days a week this person may book. Null = the organization default.
  /// Same shape as `noticePeriodDays` above, and for the same reason: a
  /// fully-remote hire and a caregiver are ordinary arrangements, not
  /// exceptions worth turning the company cap off for.
  remoteDaysPerWeek Int?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  designation    Designation?    @relation(fields: [designationId], references: [id])
  location       Location?       @relation(fields: [locationId], references: [id])
  manager        Employee?       @relation("ReportsTo", fields: [managerId], references: [id])
  reports        Employee[]      @relation("ReportsTo")
  shift          Shift?          @relation(fields: [shiftId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  headOf         Department?     @relation("DeptHead")

  emergencyContacts  EmergencyContact[]
  bankDetail         BankDetail?
  salaries           EmployeeSalary[]
  payslips           Payslip[]
  adjustments        PayrollAdjustment[]
  attendance         AttendanceRecord[]
  attendanceRequests AttendanceRequest[]
  leaveRequests      LeaveRequest[]
  remoteRequests     RemoteWorkRequest[]
  leaveBalances      LeaveBalance[]
  documents          Document[]
  letters            Letter[]
  invites            EmployeeInvite[]
  onboarding         Onboarding?
  resignations       Resignation[]
  offboardings       Offboarding[]
  settlements        Settlement[]
  assetAssignments   AssetAssignment[]
  expenseClaims      ExpenseClaim[]

  /// Recruitment: what this person does on the hiring side, and — for exactly
  /// one row — the offer they were hired from.
  openingsOwned      JobOpening[] @relation("OpeningsOwned")
  candidatesReferred Candidate[]  @relation("CandidatesReferred")
  interviewsGiven    Interview[]  @relation("InterviewsGiven")
  hiredFromOffer     Offer?       @relation("HiredFromOffer")

  /// Performance: their own goals and reviews, and the reviews they were the
  /// named reviewer on. `reviewsGiven` is by snapshot rather than by the
  /// current reporting line — see PerformanceReview.reviewerId.
  goals        PerformanceGoal[]
  reviews      PerformanceReview[]
  reviewsGiven PerformanceReview[] @relation("ReviewsGiven")

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  /// The other three filters the employee list offers. `departmentId` and
  /// `status` had indexes and these did not, which is an inconsistency rather
  /// than a decision — the same screen filters on all five. `locationId`
  /// carries the directory's filter as well.
  @@index([organizationId, locationId])
  @@index([organizationId, designationId])
  @@index([organizationId, employmentTypeId])
  @@index([managerId])
  /// Both scanned by the daily lifecycle tick and by the dashboard counts,
  /// which ask "whose probation ends soon" and "who is leaving soon".
  @@index([organizationId, probationEndDate])
  @@index([organizationId, exitDate])
}

model BankDetail {
  id                String   @id @default(cuid())
  employeeId        String   @unique
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String?
  branch            String?
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id         String @id @default(cuid())
  employeeId String
  name       String
  relation   String
  phone      String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Read on every profile view and every employee record, always by this
  /// column, and the table had nothing but its primary key.
  @@index([employeeId])
}

// ─── Attendance ───────────────────────────────────────────────────────

model Shift {
  id             String @id @default(cuid())
  organizationId String
  name           String
  startTime      String
  endTime        String
  graceMinutes   Int    @default(15)

  employees Employee[]

  @@unique([organizationId, name])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  WFH
}

enum AttendanceSource {
  WEB
  MOBILE
  ADMIN
  IMPORT
}

/// One row per employee per day — the unit payroll and reports aggregate on.
/// The times here are a *rollup* of the day's sessions, not the source of
/// truth: `checkIn` is the first session's, `checkOut` the last session's (null
/// while one is still open), and `workMinutes` the sum of the closed ones.
model AttendanceRecord {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  workMinutes    Int?
  isLate         Boolean          @default(false)
  status         AttendanceStatus @default(PRESENT)
  source         AttendanceSource @default(WEB)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  /// The day's mode, rolled up from its sessions so reports never join them.
  /// A day of mixed sittings reads as OFFICE — they did come in.
  workMode WorkMode?

  employee Employee            @relation(fields: [employeeId], references: [id])
  sessions AttendanceSession[]

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

/// A single clock-in/clock-out pair. A day holds as many as the person works,
/// so leaving for lunch — or clocking out by accident — never ends the day.
/// `checkOut` is null exactly while the person is currently clocked in.
model AttendanceSession {
  id        String           @id @default(cuid())
  recordId  String
  checkIn   DateTime
  checkOut  DateTime?
  source    AttendanceSource @default(WEB)
  createdAt DateTime         @default(now())

  /// What the person said they were doing. A claim, not a fact — the columns
  /// below are the evidence taken at the same moment.
  workMode   WorkMode @default(OFFICE)
  /// The office a fix was measured against, when one matched or came closest.
  locationId String?

  inLatitude       Float?
  inLongitude      Float?
  inAccuracyMeters Int?
  inVerification   LocationVerification @default(NOT_APPLICABLE)
  /// Metres from `location` at check-in — kept as evidence, frozen at the
  /// moment of the punch, because an office may be moved or re-fenced later.
  inDistanceMeters Int?

  outLatitude       Float?
  outLongitude      Float?
  outAccuracyMeters Int?
  outVerification   LocationVerification @default(NOT_APPLICABLE)
  outDistanceMeters Int?

  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  location Location?        @relation(fields: [locationId], references: [id])

  @@index([recordId, checkIn])
}

/// Where someone is working, as they declare it when clocking in.
enum WorkMode {
  OFFICE
  REMOTE
  CLIENT_SITE
}

/// Whether an OFFICE claim was borne out by the position taken alongside it.
/// Deliberately four values: "we could not tell" is a different answer from
/// "they were not there", and only one of them is an accusation.
enum LocationVerification {
  /// Inside an office geofence.
  VERIFIED
  /// A usable fix that lands outside every office.
  OUTSIDE
  /// No position, or one too vague to conclude anything from.
  UNVERIFIED
  /// Remote or client site — there is nothing to check against.
  NOT_APPLICABLE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRequest {
  id           String         @id @default(cuid())
  employeeId   String
  date         DateTime       @db.Date
  requestedIn  DateTime?
  requestedOut DateTime?
  reason       String
  status       ApprovalStatus @default(PENDING)
  approverId   String?
  actedAt      DateTime?
  approverNote String?
  createdAt    DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
}

/// Permission to work remotely on particular days.
///
/// Attendance already *detects* who worked from home — `detectPlacement` reads
/// it off the position taken at the punch, and a remote day rolls up to status
/// WFH. This is the other half: who was allowed to, agreed in advance.
///
/// Nothing here is enforced at clock-in. A day worked from home with no
/// approval behind it is still recorded, and flagged on read — a burst pipe at
/// 7am is not a policy violation the software should adjudicate, and refusing
/// the punch would lose the record of a day somebody worked.
model RemoteWorkRequest {
  id             String @id @default(cuid())
  organizationId String
  employeeId     String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// Working days the range actually covers, counted at submission against the
  /// working week and the holiday calendar. Stored rather than recomputed: a
  /// holiday added later must not change the count a request was approved on.
  days      Decimal  @db.Decimal(4, 1)

  reason       String
  status       ApprovalStatus @default(PENDING)
  approverId   String?
  actedAt      DateTime?
  approverNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([organizationId, status, startDate])
  /// The read behind the flag: approved rows overlapping a date range.
  @@index([organizationId, startDate, endDate])
}

// ─── Leave ────────────────────────────────────────────────────────────

model LeaveType {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  code             String
  daysPerYear      Decimal  @db.Decimal(5, 1)
  isPaid           Boolean  @default(true)
  carryForward     Boolean  @default(false)
  maxCarryForward  Decimal? @db.Decimal(5, 1)
  requiresApproval Boolean  @default(true)
  /// Paid out on exit for whatever balance is left. Off by default: most
  /// leave types are use-it-or-lose-it, and encashing everything by accident
  /// is an expensive default to get wrong.
  encashable       Boolean  @default(false)

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@unique([organizationId, code])
}

model LeaveBalance {
  id          String  @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Decimal @db.Decimal(5, 1)
  used        Decimal @default(0) @db.Decimal(5, 1)
  carriedOver Decimal @default(0) @db.Decimal(5, 1)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

enum HalfDaySide {
  FIRST_HALF
  SECOND_HALF
}

model LeaveRequest {
  id           String         @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  /// Leave year this request books against, fixed when it is raised. Derived
  /// from the org's leave-year start month, which an admin can change — so it
  /// must be stored, or approve and cancel could hit different balance rows.
  leaveYear    Int
  halfDaySide  HalfDaySide?
  days         Decimal        @db.Decimal(5, 1)
  reason       String
  status       ApprovalStatus @default(PENDING)
  approverId   String?
  actedAt      DateTime?
  approverNote String?
  createdAt    DateTime       @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, status])
  @@index([status, startDate])
}

// ─── Documents ────────────────────────────────────────────────────────

model DocumentCategory {
  id             String @id @default(cuid())
  organizationId String
  name           String

  documents Document[]

  @@unique([organizationId, name])
}

enum DocVisibility {
  PRIVATE
  ORG
}

model Document {
  id             String        @id @default(cuid())
  organizationId String
  employeeId     String?
  categoryId     String?
  name           String
  fileKey        String
  mimeType       String
  sizeBytes      Int
  visibility     DocVisibility @default(PRIVATE)
  /// Nullable because some uploads genuinely have no user behind them: a CV
  /// arriving through the public careers page is posted by somebody with no
  /// account, no employee record and no session. `AuditLog.actorId` is
  /// nullable for the same reason — the daily lifecycle tick has no actor
  /// either — and before this the only way to record one was to attribute it
  /// to somebody who had not done it.
  uploadedById   String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  employee Employee?         @relation(fields: [employeeId], references: [id])
  category DocumentCategory? @relation(fields: [categoryId], references: [id])

  /// The application this file is the CV for, when it is one.
  application Application?
  /// The expense line this file is the receipt for, when it is one.
  expenseItem ExpenseItem?

  @@index([organizationId, employeeId])
}

// ─── Announcements & Notifications ────────────────────────────────────

enum Audience {
  ALL
  DEPARTMENT
  LOCATION
}

enum AnnouncementCategory {
  GENERAL
  HOLIDAY
  BIRTHDAY
  POLICY
}

enum AnnouncementPriority {
  NORMAL
  HIGH
  URGENT
}

model Announcement {
  id             String               @id @default(cuid())
  organizationId String
  title          String
  body           String
  category       AnnouncementCategory @default(GENERAL)
  priority       AnnouncementPriority @default(NORMAL)
  audience       Audience             @default(ALL)
  departmentId   String?
  locationId     String?
  isPinned       Boolean              @default(false)
  publishAt      DateTime             @default(now())
  expiresAt      DateTime?
  authorId       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  reads       AnnouncementRead[]
  attachments AnnouncementAttachment[]

  @@index([organizationId, publishAt])
}

model AnnouncementAttachment {
  id             String   @id @default(cuid())
  announcementId String
  name           String
  fileKey        String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ─── Settings & Audit ─────────────────────────────────────────────────

model Setting {
  organizationId String
  key            String
  value          Json

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
}

/// Subject/body for system emails, editable from Settings. Keyed by a stable
/// template key; a missing or inactive row falls back to the built-in default
/// so a bad edit can never stop password reset from sending.
model EmailTemplate {
  organizationId String
  key            String
  subject        String
  bodyHtml       String
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entity         String
  entityId       String?
  meta           Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([organizationId, action])
  @@index([organizationId, actorId])
}

// ─── Payroll ──────────────────────────────────────────────────────────
//
// Money is Decimal(14,2) everywhere — never Float. A payslip, once
// calculated, is a snapshot: nothing on it is a live join, so it still
// reads true after the employee is promoted, transferred, or the salary
// structure behind it is edited.

enum PayComponentKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

/// Org-scoped catalogue of everything that can appear on a payslip line.
model PayComponent {
  id             String           @id @default(cuid())
  organizationId String
  code           String
  name           String
  kind           PayComponentKind
  /// Counts toward taxable income. Reimbursements and employer
  /// contributions do not.
  taxable        Boolean          @default(true)
  /// Computed by the statutory engine rather than the structure (PF/ESI/PT).
  isStatutory    Boolean          @default(false)
  /// Seeded and undeletable — the calculation engine references these codes.
  isSystem       Boolean          @default(false)
  order          Int              @default(0)
  active         Boolean          @default(true)

  organization      Organization        @relation(fields: [organizationId], references: [id])
  structureLines    StructureLine[]
  adjustments       PayrollAdjustment[]
  expenseCategories ExpenseCategory[]

  @@unique([organizationId, code])
  @@index([organizationId, kind])
}

/// A one-off amount for one employee in one month: a bonus, an incentive, a
/// loan instalment. The calculation engine has always accepted these; this is
/// where they are entered.
///
/// Deliberately not prorated and deliberately not part of the salary
/// structure — a structure is what somebody earns every month, and a bonus is
/// the opposite of that. Keeping them apart means a one-off never has to be
/// added to a structure and then removed again, which is how a "temporary"
/// component becomes permanent.
model PayrollAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  /// yyyy-MM, matching PayrollRun.month — an adjustment belongs to a month,
  /// not to a run, so it survives the run being deleted and recalculated.
  month          String
  componentId    String
  amount         Decimal  @db.Decimal(14, 2)
  /// Why. Shows on nothing the employee sees; it is for whoever approves the run.
  note           String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee  Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component PayComponent @relation(fields: [componentId], references: [id])

  /// One amount per component per person per month. Two "Bonus" rows would
  /// produce two payslip lines with the same code and no way to tell them
  /// apart; raising the single figure is the sane edit.
  @@unique([employeeId, month, componentId])
  @@index([organizationId, month])
}

enum SalaryCalcType {
  /// A fixed rupee amount.
  FLAT
  /// `value`% of the Basic component.
  PERCENT_OF_BASIC
  /// `value`% of monthly CTC.
  PERCENT_OF_CTC
  /// Left to the statutory engine (PF, ESI, PT).
  STATUTORY
  /// Whatever remains so the earnings sum to CTC. At most one per structure.
  BALANCE
}

model SalaryStructure {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  lines        StructureLine[]
  assignments  EmployeeSalary[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model StructureLine {
  id          String         @id @default(cuid())
  structureId String
  componentId String
  calcType    SalaryCalcType
  /// Percentage or rupee amount depending on calcType; ignored for
  /// STATUTORY and BALANCE.
  value       Decimal        @default(0) @db.Decimal(14, 2)
  order       Int            @default(0)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component PayComponent    @relation(fields: [componentId], references: [id])

  @@unique([structureId, componentId])
}

enum SalaryRevisionType {
  JOINING
  INCREMENT
  PROMOTION
  TRANSFER
  ADJUSTMENT
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
}

/// Effective-dated salary. This table *is* the revision history: the row
/// with the greatest effectiveFrom on or before a date is the salary as at
/// that date, and the row before it is the previous salary. A separate
/// history table would be free to disagree with the live value.
model EmployeeSalary {
  id            String             @id @default(cuid())
  employeeId    String
  structureId   String
  effectiveFrom DateTime           @db.Date
  monthlyCtc    Decimal            @db.Decimal(14, 2)
  /// Monthly TDS is entered rather than projected — real TDS needs annual
  /// projection, regime choice and investment proofs.
  monthlyTds    Decimal            @default(0) @db.Decimal(14, 2)
  revisionType  SalaryRevisionType @default(JOINING)
  reason        String?
  paymentMethod PaymentMethod      @default(BANK_TRANSFER)
  approvedById  String?
  createdAt     DateTime           @default(now())

  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure @relation(fields: [structureId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

enum PayrollRunStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  LOCKED
  PUBLISHED
  CANCELLED
}

model PayrollRun {
  id             String           @id @default(cuid())
  organizationId String
  /// "YYYY-MM", matching the month keys used across attendance.
  month          String
  status         PayrollRunStatus @default(DRAFT)
  payDate        DateTime?        @db.Date
  notes          String?

  calculatedAt   DateTime?
  calculatedById String?
  approvedAt     DateTime?
  approvedById   String?
  lockedAt       DateTime?
  lockedById     String?
  publishedAt    DateTime?
  publishedById  String?

  /// Denormalised so the runs list does not aggregate every payslip.
  /// Rewritten on every calculation; asserted against the payslips in tests.
  employeeCount     Int     @default(0)
  totalEarnings     Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions   Decimal @default(0) @db.Decimal(14, 2)
  totalEmployerCost Decimal @default(0) @db.Decimal(14, 2)
  netPayable        Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  payslips     Payslip[]

  @@unique([organizationId, month])
  @@index([organizationId, status])
}

enum PayslipPaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Payslip {
  id             String @id @default(cuid())
  organizationId String
  runId          String
  employeeId     String

  /// Snapshot — deliberately duplicated rather than joined, so a payslip
  /// still reads correctly after the person is renamed, moved or promoted.
  employeeCode        String
  employeeName        String
  departmentName      String?
  designationName     String?
  structureName       String
  bankName            String?
  accountNumberMasked String?
  ifsc                String?

  workingDays Decimal @db.Decimal(5, 2)
  lopDays     Decimal @default(0) @db.Decimal(5, 2)
  payableDays Decimal @db.Decimal(5, 2)

  grossEarnings        Decimal @db.Decimal(14, 2)
  totalDeductions      Decimal @db.Decimal(14, 2)
  employerContribution Decimal @default(0) @db.Decimal(14, 2)
  netPay               Decimal @db.Decimal(14, 2)
  /// Set when deductions exceeded gross and were clamped; the remainder is
  /// carried rather than paying a negative salary.
  carriedShortfall     Decimal @default(0) @db.Decimal(14, 2)

  paymentStatus PayslipPaymentStatus @default(PENDING)
  paymentMethod PaymentMethod        @default(BANK_TRANSFER)
  paidAt        DateTime?
  paymentRef    String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run      PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayslipLine[]

  @@unique([runId, employeeId])
  @@index([employeeId, createdAt])
  @@index([organizationId, paymentStatus])
}

model PayslipLine {
  id            String           @id @default(cuid())
  payslipId     String
  componentCode String
  componentName String
  kind          PayComponentKind
  amount        Decimal          @db.Decimal(14, 2)
  order         Int              @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

// ─── Letters ──────────────────────────────────────────────────────────
// Generated employment letters: offer, appointment, experience, salary
// certificate. Templates are per-org overrides of a shipped catalogue; an
// issued letter is frozen, for the reason payslips are (doc 13).

enum LetterStatus {
  ISSUED
  VOID
}

/// Per-org override of a built-in letter template. A row exists only when an
/// organization has edited one — absence means "use the shipped default", and
/// deleting the row is Reset. Same contract as EmailTemplate.
model LetterTemplate {
  organizationId String
  key            String
  /// The heading printed on the page — the analogue of an email subject.
  title          String
  bodyHtml       String
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
}

model Letter {
  id             String @id @default(cuid())
  organizationId String
  employeeId     String
  /// Matches LetterTemplate.key and the shipped catalogue. A string rather
  /// than an enum so adding a template is not a migration.
  templateKey    String
  /// Printed on the letter — "OFR/2026/0007".
  letterNumber   String

  /// FROZEN. The rendered document exactly as it was issued. Values were
  /// HTML-escaped at render time and that escaping is load-bearing: anything
  /// interpolated here is permanent and re-renders on every view.
  title    String
  bodyHtml String

  /// Frozen index over the body, duplicated rather than joined so the list
  /// still reads correctly after a department is renamed — and so the salary
  /// gate below is answerable without parsing HTML.
  employeeCode    String
  employeeName    String
  departmentName  String?
  designationName String?
  joinDate        DateTime  @db.Date
  exitDate        DateTime? @db.Date
  monthlyCtc      Decimal?  @db.Decimal(14, 2)

  /// The access gate. Derived at issue time from the catalogue flag OR the
  /// salary variables the effective body actually uses, so an org that adds
  /// {{monthlyCtc}} to a customised template cannot slip past it. An
  /// authorization decision that needed a regex over a document body is a
  /// decision you eventually get wrong.
  containsSalary Boolean @default(false)

  /// The exact variable map used to render — answers "what figure did we
  /// quote in March?" without re-deriving it from a template that has moved.
  variables Json

  status     LetterStatus @default(ISSUED)
  issuedAt   DateTime     @default(now())
  /// User id, matching Document.uploadedById.
  issuedById String
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([organizationId, letterNumber])
  @@index([employeeId, issuedAt])
  @@index([organizationId, templateKey, issuedAt])
}

// ─── Onboarding ───────────────────────────────────────────────────────
// A new hire is invited by email at their PERSONAL address, sets their own
// password through a single-use link, fills in their details and documents,
// and becomes ACTIVE only when HR approves what they submitted.
// docs/07-auth-architecture.md specified this flow; this is it.

/// Single-use invitation to set a password and start onboarding.
///
/// Deliberately NOT PasswordResetToken. That token lives an hour and only
/// changes a password; this one lives a week and also flips a User from
/// INVITED to ACTIVE. Sharing one table would make a plain password-reset
/// token a way to activate an invited account.
model EmployeeInvite {
  id          String    @id @default(cuid())
  employeeId  String
  /// sha256 of the token that was emailed — the raw value is never stored.
  tokenHash   String    @unique
  /// The personal address it went to. Answers "where did we send it?" weeks
  /// later, when the hire says nothing arrived.
  sentToEmail String
  expiresAt   DateTime
  usedAt      DateTime?
  /// Superseded by a re-invite, or killed when the employee was deleted.
  /// Revoked rather than deleted: the row is the evidence HR did invite.
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

enum OnboardingStatus {
  /// Signed in and filling things in. There is no INVITED member: that fact
  /// is already `User.status`, and one state in two columns is one column too
  /// many.
  IN_PROGRESS
  /// Waiting on HR.
  SUBMITTED
  /// HR accepted; the employee is ACTIVE.
  APPROVED
}

model Onboarding {
  id         String           @id @default(cuid())
  employeeId String           @unique
  status     OnboardingStatus @default(IN_PROGRESS)

  /// Null = not yet answered, which keeps the documents step incomplete. A
  /// first-jobber answers `false` and the relieving-letter requirement is
  /// satisfied by the declaration rather than silently waived — "declared
  /// first job on 3 Aug" is an answer, an empty folder is not.
  hasPreviousEmployment Boolean?

  /// The checklist, as foreign keys rather than a count of files in a folder.
  /// Folders are renameable and deletable, so matching them by name breaks the
  /// first time HR renames "Certificates".
  idProofDocId        String?
  bankProofDocId      String?
  educationDocId      String?
  prevEmploymentDocId String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  /// Why HR sent it back, shown to the employee on the wizard.
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── Exit: resignation and offboarding ────────────────────────────────
//
// Two tables, not one, because the two halves have different owners and
// different lifetimes. A resignation is a request an employee makes and two
// people decide on; an offboarding is the operational work of somebody
// leaving, and it happens identically whether they resigned, were dismissed,
// or reached the end of a contract.
//
// Neither writes Employee.status or Employee.exitDate. Both call
// EmploymentTransitionService, which is the only thing that does — the same
// path the HR offboard dialog has always used.

enum ResignationStatus {
  /// Filed, waiting on the manager — or on HR directly, when the
  /// organization runs no manager step or the employee has no manager.
  SUBMITTED
  /// The manager agreed; HR has the final say.
  MANAGER_APPROVED
  /// Sent back to the employee to change something.
  CHANGES_REQUESTED
  /// HR accepted. An Offboarding now exists and the employee is ON_NOTICE.
  APPROVED
  REJECTED
  WITHDRAWN
  /// The offboarding finished. Terminal, and what lets a re-hire file again.
  COMPLETED
}

enum ResignationReason {
  BETTER_OPPORTUNITY
  COMPENSATION
  RELOCATION
  HIGHER_STUDIES
  HEALTH
  PERSONAL
  WORK_ENVIRONMENT
  CAREER_CHANGE
  OTHER
}

model Resignation {
  id             String            @id @default(cuid())
  organizationId String
  employeeId     String
  status         ResignationStatus @default(SUBMITTED)

  reason  ResignationReason
  /// The employee's own words. Required when the reason is OTHER.
  remarks String?

  /// What they asked for.
  requestedLastWorkingDate DateTime  @db.Date
  /// What HR settled on. Null until approved; then this is the date the
  /// offboarding and the employee's exitDate both take.
  approvedLastWorkingDate  DateTime? @db.Date

  /// The notice in force when this was filed, and the date it implied.
  /// Frozen rather than recomputed: changing the company default in Settings
  /// must not rewrite what was agreed with somebody who already resigned.
  noticeDays              Int
  earliestLastWorkingDate DateTime @db.Date

  submittedAt DateTime @default(now())

  /// Who the manager step was routed to, captured at submit. A reporting
  /// change afterwards must not move a decision that already happened, or
  /// leave a request addressed to nobody.
  routedManagerId    String?
  managerDecidedAt   DateTime?
  managerDecidedById String?
  managerRemarks     String?

  hrDecidedAt   DateTime?
  hrDecidedById String?
  hrRemarks     String?

  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  offboarding Offboarding?

  @@index([organizationId, status])
  @@index([employeeId])
  @@index([routedManagerId, status])
}

enum OffboardingReason {
  RESIGNATION
  TERMINATION
  CONTRACT_END
  RETIREMENT
  ABSCONDING
  OTHER
}

enum OffboardingStatus {
  /// Serving notice. There is no NOT_STARTED: the row is created when the
  /// offboarding starts, so the state could never occur.
  IN_PROGRESS
  COMPLETED
  /// Called off — a resignation withdrawn after approval, or a dismissal
  /// reversed. The employee goes back to ACTIVE.
  CANCELLED
}

model Offboarding {
  id             String  @id @default(cuid())
  organizationId String
  employeeId     String
  /// Null when HR started it directly: a termination, a contract ending, a
  /// retirement. Unique because one resignation produces one offboarding.
  resignationId  String? @unique

  reason          OffboardingReason
  reasonNote      String?
  lastWorkingDate DateTime          @db.Date
  status          OffboardingStatus @default(IN_PROGRESS)

  /// Frozen at start, the way Letter freezes its variables. An exit record
  /// has to still read true after the department it names is reorganised
  /// away or the manager who signed it off has themselves left.
  snapshotDepartment  String?
  snapshotDesignation String?
  snapshotManagerName String?
  snapshotJoinDate    DateTime @db.Date

  startedAt     DateTime  @default(now())
  /// Null when the daily tick opened it — nobody pressed anything.
  startedById   String?
  completedAt   DateTime?
  completedById String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resignation Resignation?      @relation(fields: [resignationId], references: [id])
  tasks       OffboardingTask[]
  interview   ExitInterview?
  settlement  Settlement?

  @@index([organizationId, status])
  @@index([employeeId])
  @@index([organizationId, lastWorkingDate])
}

/// Who signs a clearance item off.
///
/// IT_ADMIN has no matching system role — the seeded five are Admin, HR,
/// Finance, Manager and Employee. Those items fall to `employee.offboard`
/// holders until an organization composes an IT role in Settings → Roles.
/// Naming the owner anyway is what makes the list mean something to a human,
/// and what lets an IT role start working the day it exists.
enum ClearanceOwner {
  MANAGER
  HR
  FINANCE
  IT_ADMIN
}

enum OffboardingTaskStatus {
  PENDING
  DONE
  /// Waived with a reason. A contractor with no company laptop is closed
  /// honestly rather than by ticking a box that says the laptop came back.
  NOT_APPLICABLE
}

/// One line of the exit checklist.
///
/// Copied from the organization's template at start and never joined back to
/// it — the same freezing rule `Offboarding`'s snapshot fields and
/// `Letter.variables` follow. Editing the template must not rewrite an exit
/// that is half signed off: somebody who has already returned their laptop has
/// returned it whatever the list says next week.
/// What settles a clearance item.
///
/// MANUAL is somebody signing it off. ASSET_RETURN is computed from the asset
/// register — `AssetClearanceService` owns its status, and it cannot be ticked
/// to DONE by hand, because the register is the truth. Waiving it as
/// NOT_APPLICABLE still works: "they posted it back, write it off" is a real
/// answer and it already requires a reason.
enum ClearanceKind {
  MANUAL
  ASSET_RETURN
}

model OffboardingTask {
  id            String                @id @default(cuid())
  offboardingId String
  label         String
  description   String?
  owner         ClearanceOwner
  /// Copied from the template at start, like every other field here. Defaults
  /// to MANUAL so an organization that saved a checklist before assets existed
  /// keeps hand-signing until they switch it on — silently turning a
  /// completion gate on could block an exit already in flight.
  kind          ClearanceKind         @default(MANUAL)
  /// Completion is blocked while any required item is still PENDING.
  required      Boolean               @default(true)
  order         Int
  status        OffboardingTaskStatus @default(PENDING)
  /// What was handed back, or why it was waived. Shown on the exit record.
  note          String?
  doneAt        DateTime?
  doneById      String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  offboarding Offboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@index([offboardingId, order])
  @@index([offboardingId, status])
}

/// The exit conversation, as HR recorded it.
///
/// Read by `employee.offboard` holders only — deliberately not by the leaver's
/// own manager, who is very often the subject of the answers.
model ExitInterview {
  id            String    @id @default(cuid())
  offboardingId String    @unique
  conductedOn   DateTime? @db.Date
  conductedById String?

  /// [{ key, question, answer }] — the question text is frozen alongside the
  /// answer, so changing the questionnaire in a later release cannot rewrite
  /// what somebody already said.
  responses Json    @default("[]")
  notes     String?

  /// The two facts HR actually reports on afterwards.
  wouldRecommend Boolean?
  rehireEligible Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offboarding Offboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Full & final settlement
// ─────────────────────────────────────────────────────────────────────────────

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum SettlementLineKind {
  EARNING
  DEDUCTION
}

/// Where a line came from. `MANUAL` is HR's own — a retention bonus, a tax
/// deduction, a laptop nobody returned. The other three are computed, and are
/// what a recompute rebuilds; a manual line survives one.
enum SettlementLineSource {
  LEAVE_ENCASHMENT
  NOTICE_RECOVERY
  GRATUITY
  MANUAL
}

/// What a leaver is owed, as one document.
///
/// Not a `PayrollRun`, and that is the load-bearing decision. A run is unique
/// per organization per month, prorates by working days and computes statutory
/// deductions on gross — all three wrong for a settlement, which lands weeks
/// after the last working day and must not push somebody's monthly gross past
/// the ESI threshold. It carries its own figures instead.
model Settlement {
  id             String @id @default(cuid())
  organizationId String
  /// One settlement per exit, not per employee: somebody rehired and leaving
  /// again gets a second one against a second offboarding.
  offboardingId  String @unique
  employeeId     String

  status SettlementStatus @default(DRAFT)

  /// Frozen when it is computed, the way Payslip and Offboarding already
  /// freeze. A salary revision or a leave adjustment afterwards must not
  /// silently rewrite a settlement somebody has already been shown.
  lastWorkingDate DateTime @db.Date
  joinDate        DateTime @db.Date
  /// The monthly figure the day rate came from — basic or gross, whichever the
  /// organization prices settlements off. Named for what it holds, not for the
  /// setting that chose it.
  monthlyPay      Decimal  @db.Decimal(14, 2)
  perDayRate      Decimal  @db.Decimal(14, 2)

  totalEarnings   Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  /// Earnings less deductions. Allowed to be negative: somebody whose notice
  /// recovery exceeds their dues owes the company, and a floor of zero would
  /// make the total disagree with the lines above it.
  netPayable      Decimal @default(0) @db.Decimal(14, 2)

  notes      String?
  computedAt DateTime?

  approvedAt   DateTime?
  approvedById String?
  paidAt       DateTime?
  paidById     String?
  /// The bank reference, so Finance can tie this to a statement line.
  paymentRef   String?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offboarding Offboarding      @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines       SettlementLine[]

  @@index([organizationId, status])
  @@index([employeeId])
  @@index([organizationId, lastWorkingDate])
}

/// One figure on the statement.
///
/// Carries its own id rather than keying on a component code, because two
/// encashable leave types produce two lines that mean different things. The
/// payslip screen keys its rows on `line.code` and would collide here.
model SettlementLine {
  id           String               @id @default(cuid())
  settlementId String
  kind         SettlementLineKind
  source       SettlementLineSource
  label        String
  /// How the figure was reached — "12.5 days × ₹2,400". Printed under the
  /// amount, because a number nobody can check is a number nobody accepts.
  basis        String?
  amount       Decimal              @db.Decimal(14, 2)
  order        Int
  /// HR changed the computed figure. Kept so the statement can say so rather
  /// than presenting a negotiated number as if the system had produced it.
  overridden   Boolean              @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, order])
}

// ─────────────────────────────────────────────────────────────────────────────
// Assets
// ─────────────────────────────────────────────────────────────────────────────

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  LOST
  RETIRED
}

/// Recorded on the way out and again on the way back, so "it came back
/// scratched" is a fact on the record rather than an argument later.
enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

/// Per-organization, exactly like DocumentCategory. A table rather than a
/// settings list because assets are filtered and counted by category, and a
/// free-text category would make both unreliable.
model AssetCategory {
  id             String @id @default(cuid())
  organizationId String
  name           String

  assets Asset[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// One physical thing. Per-item rather than a stock count, which is what makes
/// "who has SN-4471" and the exit clearance answerable at all.
model Asset {
  id             String @id @default(cuid())
  organizationId String
  categoryId     String

  /// Printed on the sticker — "MAC-0042".
  assetTag     String
  name         String
  serialNumber String?
  make         String?
  model        String?

  /// Stored rather than derived, and written in exactly one place. Issuing and
  /// returning move it between IN_STOCK and ASSIGNED; the other three are set
  /// by hand with a reason. Deriving "assigned" from an open assignment would
  /// have meant two axes — assigned *and* in repair — that no screen could
  /// render honestly.
  status    AssetStatus    @default(IN_STOCK)
  condition AssetCondition @default(GOOD)

  purchaseDate DateTime? @db.Date
  purchaseCost Decimal?  @db.Decimal(14, 2)
  warrantyEnd  DateTime? @db.Date
  vendor       String?
  locationId   String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    AssetCategory     @relation(fields: [categoryId], references: [id])
  location    Location?         @relation(fields: [locationId], references: [id])
  assignments AssetAssignment[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
}

/// One spell of somebody holding one asset.
///
/// History, not current state: a returned row stays so the register can answer
/// who had it in March. "Currently out" is `returnedOn IS NULL`, and the
/// partial unique index in the migration makes at-most-one-open a database
/// invariant rather than something the service hopes it checked.
model AssetAssignment {
  id         String @id @default(cuid())
  assetId    String
  employeeId String

  issuedOn     DateTime       @db.Date
  issuedById   String?
  conditionOut AssetCondition

  returnedOn   DateTime?       @db.Date
  returnedById String?
  conditionIn  AssetCondition?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId, issuedOn])
  @@index([employeeId, returnedOn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Recruitment
// ─────────────────────────────────────────────────────────────────────────────
//
// The front of the lifecycle. Everything else in this schema begins at an
// Employee; this is what happens before there is one.
//
// **A Candidate is not an Employee**, and the foreign keys say so: `Offer`
// points *at* Employee, and only once somebody is hired. Anybody who applies
// and is turned down leaves a Candidate and no Employee, which is the whole
// distinction — a rejected application must not be a deleted person, and the
// same human applying again next year must be the same row.

enum OpeningStatus {
  DRAFT
  OPEN
  /// Paused — no new applications, the ones in flight continue.
  ON_HOLD
  /// Ended without filling it.
  CLOSED
  FILLED
}

/// Where the pipeline can go.
///
/// A column rather than a table. Per-opening configurable stages is the
/// feature every ATS grows and the one that turns every count into a join;
/// this is the set the reporting actually needs. If an organization ever wants
/// its own, they belong in `Setting` as a typed group like the exit checklist,
/// which is a pattern this codebase already runs.
enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

/// Why somebody did not get the job. Recorded because "rejected" on its own
/// answers nothing three months later, and because it is what tells the
/// difference between a bad advert and a bad interview loop.
enum RejectionReason {
  SKILLS
  EXPERIENCE
  COMPENSATION
  LOCATION
  NOTICE_PERIOD
  CULTURE_FIT
  POSITION_CLOSED
  CANDIDATE_WITHDREW
  OTHER
}

enum InterviewMode {
  IN_PERSON
  VIDEO
  PHONE
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

model JobOpening {
  id               String  @id @default(cuid())
  organizationId   String
  title            String
  /// Reuses the org structure rather than free text, so an opening filters and
  /// reports alongside the people already in that department.
  departmentId     String?
  designationId    String?
  locationId       String?
  employmentTypeId String?
  /// Who owns the loop. Nullable because an opening can be raised before the
  /// manager is settled.
  hiringManagerId  String?

  /// The public URL for this role, e.g. `senior-backend-engineer`. Generated
  /// from the title and unique per organization.
  ///
  /// Nullable because every opening that predates the careers page has none,
  /// and a role is perfectly usable internally without one — a null simply
  /// means "not published", which is also the safe default for a column added
  /// to rows nobody reviewed.
  slug String?

  headcount     Int           @default(1)
  status        OpeningStatus @default(DRAFT)
  description   String?
  /// The band, for the offer conversation. Nullable throughout: plenty of
  /// organizations do not publish one internally either.
  minMonthlyCtc Decimal?      @db.Decimal(14, 2)
  maxMonthlyCtc Decimal?      @db.Decimal(14, 2)

  openedOn DateTime? @db.Date
  closedOn DateTime? @db.Date

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  designation    Designation?    @relation(fields: [designationId], references: [id])
  location       Location?       @relation(fields: [locationId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  hiringManager  Employee?       @relation("OpeningsOwned", fields: [hiringManagerId], references: [id])
  applications   Application[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([hiringManagerId, status])
}

/// One person, once.
///
/// Unique on email per organization, so somebody who applies to three openings
/// is one candidate with three applications, and a re-applicant next year is
/// the same history rather than a stranger.
model Candidate {
  id             String @id @default(cuid())
  organizationId String

  firstName String
  lastName  String
  email     String
  phone     String?

  currentEmployer    String?
  currentTitle       String?
  /// What they say they are on, in days. Their word rather than a contract —
  /// it is what the start date gets planned around.
  noticePeriodDays   Int?
  expectedMonthlyCtc Decimal? @db.Decimal(14, 2)

  /// Where they came from. Plain text rather than an enum: referral sources are
  /// somebody's name, and job boards come and go.
  source     String?
  /// Who referred them, when the source is a colleague.
  referrerId String?
  notes      String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  referrer     Employee?     @relation("CandidatesReferred", fields: [referrerId], references: [id])
  applications Application[]

  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
}

/// One candidate against one opening.
model Application {
  id             String @id @default(cuid())
  /// Denormalised off the opening so the pipeline can be scoped and counted
  /// without a join, the way every other module here scopes by organization.
  organizationId String
  candidateId    String
  openingId      String

  stage           ApplicationStage @default(APPLIED)
  rejectionReason RejectionReason?
  /// The sentence somebody would want to read later. Required by the service
  /// when the reason is OTHER, the way Resignation already requires remarks.
  rejectionNote   String?

  appliedOn        DateTime  @default(now())
  decidedAt        DateTime?
  /// The CV, as a Document — so it goes through the same storage adapter, size
  /// and type checks and streaming download as every other file in the product.
  resumeDocumentId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  opening      JobOpening   @relation(fields: [openingId], references: [id], onDelete: Cascade)
  resume       Document?    @relation(fields: [resumeDocumentId], references: [id])
  interviews   Interview[]
  offer        Offer?

  /// One application per person per opening. Applying twice is the same
  /// application moving, not a second one.
  @@unique([candidateId, openingId])
  @@index([organizationId, stage])
  @@index([openingId, stage])
}

/// A conversation, and what came of it.
///
/// The feedback freezes when it is submitted: `submittedAt` set means the
/// recommendation and notes stop being editable. The same rule as `Letter`'s
/// frozen body and `Offboarding`'s snapshots, and for a sharper reason — a
/// recommendation that can be rewritten after the decision is evidence of
/// nothing.
model Interview {
  id            String  @id @default(cuid())
  applicationId String
  /// Nullable: a panel member can leave, and the interview still happened.
  interviewerId String?

  scheduledFor    DateTime
  durationMinutes Int           @default(45)
  mode            InterviewMode @default(VIDEO)
  /// "Technical round", "Culture fit" — free text, because every company names
  /// these differently and none of the names mean anything to the schema.
  round           String?

  recommendation InterviewRecommendation?
  notes          String?
  submittedAt    DateTime?

  cancelledAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer Employee?   @relation("InterviewsGiven", fields: [interviewerId], references: [id])

  @@index([applicationId, scheduledFor])
  @@index([interviewerId, scheduledFor])
}

/// What was offered, and what became of it.
///
/// The job details are copied rather than joined. An offer is a statement made
/// on a day — the same freezing rule as Payslip and Settlement — so the opening
/// it came from can be edited or closed afterwards without rewriting what
/// somebody was told.
model Offer {
  id             String @id @default(cuid())
  organizationId String
  applicationId  String @unique

  status OfferStatus @default(DRAFT)

  designationId    String?
  departmentId     String?
  locationId       String?
  employmentTypeId String?
  monthlyCtc       Decimal   @db.Decimal(14, 2)
  joinDate         DateTime  @db.Date
  /// After which it lapses. Nothing expires it on a timer — there is no
  /// scheduler here — so it is derived on read, like everything else.
  expiresOn        DateTime? @db.Date

  notes String?

  sentAt          DateTime?
  respondedAt     DateTime?
  /// Set only once an accepted offer has been converted into staff. Nullable,
  /// and pointing at Employee rather than the other way round: this is the one
  /// place the two halves of the lifecycle touch.
  hiredEmployeeId String?   @unique

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  designation    Designation?    @relation(fields: [designationId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  location       Location?       @relation(fields: [locationId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  hiredEmployee  Employee?       @relation("HiredFromOffer", fields: [hiredEmployeeId], references: [id])

  @@index([organizationId, status])
}

// ─── Expenses & reimbursement ─────────────────────────────────────────

/// A claim's own states, rather than the shared `ApprovalStatus`.
///
/// `ApprovalStatus` is PENDING/APPROVED/REJECTED/CANCELLED, and a claim needs
/// a DRAFT to add lines to before anybody sees it. Widening the shared enum
/// would make DRAFT representable on `LeaveRequest.status` and every other
/// approval in the product — a redesign of things this module has no business
/// touching (docs/01 rule 4). Settlements made the same call for the same
/// reason.
///
/// There is no PAID. Whether the money arrived is whether the payroll run for
/// `payrollMonth` was published, and that is derived on read — the same
/// bargain attendance's day-close and announcement expiry already make. A
/// stored PAID would be a second copy of a fact payroll already owns, and the
/// copy is the one that goes stale.
enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// What can be claimed for, and what it becomes on the payslip.
model ExpenseCategory {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  /// The most one claim may total under this category. Null means no ceiling;
  /// the check is a refusal at submission, not a warning, because an approver
  /// reading a number has no way to know a limit was exceeded.
  capPerClaim     Decimal? @db.Decimal(14, 2)
  requiresReceipt Boolean  @default(true)
  /// Which payslip line an approved claim becomes. Not optional: a category
  /// with nowhere to pay out to is a form that collects receipts and returns
  /// no money, which is worse than not offering it.
  componentId     String
  active          Boolean  @default(true)
  order           Int      @default(0)

  organization Organization  @relation(fields: [organizationId], references: [id])
  component    PayComponent  @relation(fields: [componentId], references: [id])
  items        ExpenseItem[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model ExpenseClaim {
  id             String             @id @default(cuid())
  organizationId String
  employeeId     String
  title          String
  status         ExpenseClaimStatus @default(DRAFT)
  /// yyyy-MM, and set by the approver rather than at submission: which month
  /// somebody is paid in is a decision, and a claim filed on the 31st is
  /// usually next month's.
  payrollMonth   String?
  submittedAt    DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items        ExpenseItem[]
  organization Organization  @relation(fields: [organizationId], references: [id])

  /// The approvals inbox reads status across the org; everything else reads
  /// one person's claims newest first.
  @@index([organizationId, status])
  @@index([employeeId, createdAt])
}

model ExpenseItem {
  id          String   @id @default(cuid())
  claimId     String
  categoryId  String
  spentOn     DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  description String
  /// The receipt, as a Document — so it goes through the same private bucket,
  /// the same size limit and the same permission check as every other file
  /// here. `Application.resumeDocumentId` is the same arrangement.
  receiptId   String?  @unique

  claim    ExpenseClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  receipt  Document?       @relation(fields: [receiptId], references: [id])

  @@index([claimId])
}

enum EmployeeImportMode {
  RECORDS
  INVITE
}

enum EmployeeImportStatus {
  PREVIEW
  COMMITTED
  PARTIAL
  FAILED
}

/// A bulk import, from the moment it is previewed to what it actually did.
///
/// Stateful rather than stateless, and that is the load-bearing call. The
/// alternative — the browser posting parsed rows back to commit — means the
/// commit endpoint trusts a client-supplied row set, so it has to re-validate
/// everything anyway *and* somebody can commit rows that never appeared in a
/// preview. Holding it here buys the opposite guarantee: what commits is
/// exactly what was previewed.
///
/// It also buys an audit answer better than two hundred separate
/// `employee.create` rows, and makes a second commit refusable rather than
/// duplicating everybody.
model EmployeeImport {
  id             String               @id @default(cuid())
  organizationId String
  uploadedById   String?
  fileName       String
  rowCount       Int
  mode           EmployeeImportMode   @default(RECORDS)
  status         EmployeeImportStatus @default(PREVIEW)
  /// The parsed rows while previewing; **pruned at commit** to just the
  /// outcome per row. This column holds names, emails and dates of birth, and
  /// keeping it afterwards would be a second copy of everybody's personal data
  /// with no retention story and no access control of its own.
  rows           Json
  createdCount   Int                  @default(0)
  failedCount    Int                  @default(0)
  invitedCount   Int                  @default(0)
  createdAt      DateTime             @default(now())
  committedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Performance — cycles, goals and reviews
// ─────────────────────────────────────────────────────────────────────────────

enum ReviewCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

/// Four states, and the two you expect are missing on purpose. `NOT_STARTED` is
/// `progress = 0` and `IN_PROGRESS` is `progress > 0`; storing them as well
/// would be two representations of one fact, and they would drift the first
/// time somebody moved a slider without touching a dropdown. `AT_RISK` is a
/// past `dueOn` while still ACTIVE, derived on read like everything else here.
enum GoalStatus {
  ACTIVE
  ACHIEVED
  MISSED
  CANCELLED
}

/// Who the review is waiting on — which is exactly what both inboxes render.
///
/// Drafting lives *inside* PENDING_SELF and PENDING_MANAGER: the author saves as
/// often as they like and the status does not move until they submit, the same
/// way an ExpenseClaim is edited freely while DRAFT. The finer chronology is in
/// selfSubmittedAt / managerSubmittedAt.
///
/// Deliberately not ApprovalStatus, which is PENDING/APPROVED/REJECTED/
/// CANCELLED. A review is never approved and never rejected; mapping SHARED
/// onto APPROVED would make that enum's name a lie at every call site, and
/// ACKNOWLEDGED has no member to map to at all. Widening the shared one instead
/// would make both representable on every LeaveRequest in the product — the
/// same argument ExpenseClaimStatus makes for having its own list.
enum ReviewStatus {
  PENDING_SELF
  PENDING_MANAGER
  SHARED
  ACKNOWLEDGED
  CANCELLED
}

/// A window: what period is being assessed, and when the answers are due.
///
/// Nothing here is a phase column. Where a cycle has got to is derived from
/// these dates and today, because there is no scheduler in this product and a
/// stored phase would go stale overnight and stay wrong until something
/// happened to touch it.
model ReviewCycle {
  id             String            @id @default(cuid())
  organizationId String
  /// "H1 2026". Unique per org, because the same name twice is always a mistake.
  name           String
  periodStart    DateTime          @db.Date
  periodEnd      DateTime          @db.Date
  /// When assessments are expected. Nullable — nothing enforces it, and
  /// "overdue" is derived rather than flagged by a job that does not exist.
  dueOn          DateTime?         @db.Date
  /// Service before periodEnd needed to be enrolled. On the cycle rather than
  /// in Setting because it is a per-cycle decision: a mid-year catch-up cycle
  /// wants a different answer from the annual one. It is also why this module
  /// needs no settings group at all.
  minServiceDays Int               @default(90)
  status         ReviewCycleStatus @default(DRAFT)
  openedAt       DateTime?
  closedAt       DateTime?
  /// Bare id, not a relation — the same call ExpenseClaim.decidedById makes.
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  goals        PerformanceGoal[]
  reviews      PerformanceReview[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, periodStart, periodEnd])
}

/// Something somebody is working towards, inside one cycle.
///
/// cycleId is required, and that is the load-bearing call. A goal belongs to a
/// period. Making it nullable buys "standing goals" and pays for it twice: the
/// weights-total-100 rule becomes unanswerable (100% of *what*?), and a review's
/// goal list turns into a nullable join with a silent omission — a standing goal
/// appearing in no review at all, which nobody expects.
model PerformanceGoal {
  id             String     @id @default(cuid())
  organizationId String
  cycleId        String
  employeeId     String
  title          String
  description    String?
  /// What "done" looks like, in words. A number with a unit would be a metric
  /// engine, which is OKR territory and deliberately not built.
  target         String?
  /// Percent, 0-100. Int rather than Decimal: three equal goals become 34/33/33
  /// rather than 33.33 each, which nobody has ever minded, and it keeps this
  /// whole module free of Decimal — which serialises to JSON as a string and has
  /// already put NaN on one screen in this product.
  progress       Int        @default(0)
  /// Percent of the review. 0 means unweighted, which is a legitimate choice.
  weight         Int        @default(0)
  status         GoalStatus @default(ACTIVE)
  dueOn          DateTime?  @db.Date
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  cycle        ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([cycleId, employeeId])
  @@index([employeeId, status])
  @@index([organizationId, cycleId])
}

/// One row, two authors.
///
/// Not a generic participant table keyed by (review, rater, kind) — that shape
/// generalises to 360-degree feedback, which is deliberately not built, and
/// building the general form "in case" is exactly what this repo refuses. If
/// peer feedback ever lands it is a new table FK'd to this one: additive, no
/// redesign, the same seam every other module here left.
model PerformanceReview {
  id                 String       @id @default(cuid())
  organizationId     String
  cycleId            String
  employeeId         String
  /// A **snapshot** of the employee's manager taken when the cycle opened, not
  /// a live join. A reorg in April must not hand a half-written H1 review to
  /// somebody who has never met the person, and "who reviewed me in H1 2026"
  /// has to stay answerable in 2028. The same freezing Offer and Payslip do.
  ///
  /// Nullable, because whoever is at the top of the chart has no manager. That
  /// review is enrolled anyway and HR assigns a reviewer, rather than the CEO
  /// being silently absent from every cycle the company runs.
  reviewerId         String?
  status             ReviewStatus @default(PENDING_SELF)
  selfRating         Int?
  selfComment        String?
  selfSubmittedAt    DateTime?
  managerRating      Int?
  managerComment     String?
  /// The part the employee is meant to act on, and the next cycle reads back.
  /// Merged into the comment it becomes the last paragraph nobody re-reads.
  managerActions     String?
  managerSubmittedAt DateTime?
  sharedAt           DateTime?
  acknowledgedAt     DateTime?
  acknowledgeNote    String?
  reopenNote         String?
  cancelNote         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  cycle        ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     Employee?    @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  /// What the whole module leans on: it makes opening a cycle idempotent
  /// (createMany + skipDuplicates) and two reviews for one half-year
  /// unrepresentable.
  @@unique([cycleId, employeeId])
  /// The manager's inbox, HR's coverage view, and one person's history.
  @@index([reviewerId, status])
  @@index([cycleId, status])
  @@index([employeeId, createdAt])
  @@index([organizationId, status])
}
