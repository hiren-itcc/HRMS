// HRMS schema — docs/02-database.md is the design source for this file.
// Every tenant-owned table carries organizationId (multi-tenant-ready, ADR §1.3).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & Access ────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  roles        Role[]
  employees    Employee[]
  departments  Department[]
  designations Designation[]
  locations    Location[]
  holidays     Holiday[]
  settings       Setting[]
  emailTemplates EmailTemplate[]

  payComponents     PayComponent[]
  salaryStructures  SalaryStructure[]
  payrollRuns       PayrollRun[]
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique
  passwordHash   String
  status         UserStatus @default(INVITED)
  /// Set when an account is created with a shared default password. Login
  /// succeeds but the app sends them straight to change it, so a predictable
  /// credential is never a usable one for long.
  mustChangePassword Boolean @default(false)
  roleId         String
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  role         Role                 @relation(fields: [roleId], references: [id])
  employee     Employee?
  sessions     RefreshSession[]
  resetTokens  PasswordResetToken[]

  @@index([organizationId])
  @@index([roleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  isSystem       Boolean @default(false)

  organization Organization     @relation(fields: [organizationId], references: [id])
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique
  resource String
  action   String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Organization structure ───────────────────────────────────────────

model Department {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String?
  parentId       String?
  headId         String? @unique

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children     Department[] @relation("DeptTree")
  head         Employee?    @relation("DeptHead", fields: [headId], references: [id])
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Designation {
  id             String @id @default(cuid())
  organizationId String
  title          String
  level          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, title])
}

enum LocationType {
  HEAD_OFFICE
  BRANCH
  REMOTE
  CLIENT_SITE
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           LocationType @default(BRANCH)
  address        String?
  city           String?
  country        String?
  timezone       String?

  /// The geofence attendance checks an OFFICE claim against. Optional: a
  /// location without coordinates simply cannot verify anyone, which reads as
  /// "unverified" rather than as an accusation.
  latitude             Float?
  longitude            Float?
  geofenceRadiusMeters Int    @default(200)

  organization Organization        @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  holidays     Holiday[]
  sessions     AttendanceSession[]

  @@unique([organizationId, name])
}

model EmploymentType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String?

  employees Employee[]

  @@unique([organizationId, name])
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  date           DateTime @db.Date
  isOptional     Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])

  @@unique([organizationId, locationId, date, name])
  @@index([organizationId, date])
}

// ─── Employees ────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmployeeStatus {
  ACTIVE
  ON_NOTICE
  EXITED
}

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?        @unique
  employeeCode   String
  firstName      String
  lastName       String
  workEmail      String
  personalEmail  String?
  phone          String?
  dateOfBirth    DateTime?      @db.Date
  gender         Gender?
  avatarUrl      String?
  addressLine    String?
  city           String?
  country        String?
  departmentId   String?
  designationId  String?
  locationId     String?
  managerId        String?
  shiftId          String?
  employmentTypeId String?
  status           EmployeeStatus @default(ACTIVE)
  joinDate       DateTime       @db.Date
  exitDate       DateTime?      @db.Date
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  designation  Designation? @relation(fields: [designationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  manager        Employee?       @relation("ReportsTo", fields: [managerId], references: [id])
  reports        Employee[]      @relation("ReportsTo")
  shift          Shift?          @relation(fields: [shiftId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  headOf         Department?     @relation("DeptHead")

  emergencyContacts  EmergencyContact[]
  bankDetail         BankDetail?
  salaries           EmployeeSalary[]
  payslips           Payslip[]
  attendance         AttendanceRecord[]
  attendanceRequests AttendanceRequest[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  documents          Document[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([managerId])
}

model BankDetail {
  id                String   @id @default(cuid())
  employeeId        String   @unique
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String?
  branch            String?
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id         String @id @default(cuid())
  employeeId String
  name       String
  relation   String
  phone      String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─── Attendance ───────────────────────────────────────────────────────

model Shift {
  id             String @id @default(cuid())
  organizationId String
  name           String
  startTime      String
  endTime        String
  graceMinutes   Int    @default(15)

  employees Employee[]

  @@unique([organizationId, name])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  WFH
}

enum AttendanceSource {
  WEB
  MOBILE
  ADMIN
  IMPORT
}

/// One row per employee per day — the unit payroll and reports aggregate on.
/// The times here are a *rollup* of the day's sessions, not the source of
/// truth: `checkIn` is the first session's, `checkOut` the last session's (null
/// while one is still open), and `workMinutes` the sum of the closed ones.
model AttendanceRecord {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  workMinutes    Int?
  isLate         Boolean          @default(false)
  status         AttendanceStatus @default(PRESENT)
  source         AttendanceSource @default(WEB)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  /// The day's mode, rolled up from its sessions so reports never join them.
  /// A day of mixed sittings reads as OFFICE — they did come in.
  workMode WorkMode?

  employee Employee            @relation(fields: [employeeId], references: [id])
  sessions AttendanceSession[]

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

/// A single clock-in/clock-out pair. A day holds as many as the person works,
/// so leaving for lunch — or clocking out by accident — never ends the day.
/// `checkOut` is null exactly while the person is currently clocked in.
model AttendanceSession {
  id        String           @id @default(cuid())
  recordId  String
  checkIn   DateTime
  checkOut  DateTime?
  source    AttendanceSource @default(WEB)
  createdAt DateTime         @default(now())

  /// What the person said they were doing. A claim, not a fact — the columns
  /// below are the evidence taken at the same moment.
  workMode   WorkMode @default(OFFICE)
  /// The office a fix was measured against, when one matched or came closest.
  locationId String?

  inLatitude       Float?
  inLongitude      Float?
  inAccuracyMeters Int?
  inVerification   LocationVerification @default(NOT_APPLICABLE)
  /// Metres from `location` at check-in — kept as evidence, frozen at the
  /// moment of the punch, because an office may be moved or re-fenced later.
  inDistanceMeters Int?

  outLatitude       Float?
  outLongitude      Float?
  outAccuracyMeters Int?
  outVerification   LocationVerification @default(NOT_APPLICABLE)
  outDistanceMeters Int?

  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  location Location?        @relation(fields: [locationId], references: [id])

  @@index([recordId, checkIn])
}

/// Where someone is working, as they declare it when clocking in.
enum WorkMode {
  OFFICE
  REMOTE
  CLIENT_SITE
}

/// Whether an OFFICE claim was borne out by the position taken alongside it.
/// Deliberately four values: "we could not tell" is a different answer from
/// "they were not there", and only one of them is an accusation.
enum LocationVerification {
  /// Inside an office geofence.
  VERIFIED
  /// A usable fix that lands outside every office.
  OUTSIDE
  /// No position, or one too vague to conclude anything from.
  UNVERIFIED
  /// Remote or client site — there is nothing to check against.
  NOT_APPLICABLE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRequest {
  id           String         @id @default(cuid())
  employeeId   String
  date         DateTime       @db.Date
  requestedIn  DateTime?
  requestedOut DateTime?
  reason       String
  status       ApprovalStatus @default(PENDING)
  approverId   String?
  actedAt      DateTime?
  approverNote String?
  createdAt    DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
}

// ─── Leave ────────────────────────────────────────────────────────────

model LeaveType {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  code             String
  daysPerYear      Decimal  @db.Decimal(5, 1)
  isPaid           Boolean  @default(true)
  carryForward     Boolean  @default(false)
  maxCarryForward  Decimal? @db.Decimal(5, 1)
  requiresApproval Boolean  @default(true)

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@unique([organizationId, code])
}

model LeaveBalance {
  id          String  @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Decimal @db.Decimal(5, 1)
  used        Decimal @default(0) @db.Decimal(5, 1)
  carriedOver Decimal @default(0) @db.Decimal(5, 1)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

enum HalfDaySide {
  FIRST_HALF
  SECOND_HALF
}

model LeaveRequest {
  id           String         @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  /// Leave year this request books against, fixed when it is raised. Derived
  /// from the org's leave-year start month, which an admin can change — so it
  /// must be stored, or approve and cancel could hit different balance rows.
  leaveYear    Int
  halfDaySide  HalfDaySide?
  days         Decimal        @db.Decimal(5, 1)
  reason       String
  status       ApprovalStatus @default(PENDING)
  approverId   String?
  actedAt      DateTime?
  approverNote String?
  createdAt    DateTime       @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, status])
  @@index([status, startDate])
}

// ─── Documents ────────────────────────────────────────────────────────

model DocumentCategory {
  id             String @id @default(cuid())
  organizationId String
  name           String

  documents Document[]

  @@unique([organizationId, name])
}

enum DocVisibility {
  PRIVATE
  ORG
}

model Document {
  id             String        @id @default(cuid())
  organizationId String
  employeeId     String?
  categoryId     String?
  name           String
  fileKey        String
  mimeType       String
  sizeBytes      Int
  visibility     DocVisibility @default(PRIVATE)
  uploadedById   String
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  employee Employee?         @relation(fields: [employeeId], references: [id])
  category DocumentCategory? @relation(fields: [categoryId], references: [id])

  @@index([organizationId, employeeId])
}

// ─── Announcements & Notifications ────────────────────────────────────

enum Audience {
  ALL
  DEPARTMENT
  LOCATION
}

enum AnnouncementCategory {
  GENERAL
  HOLIDAY
  BIRTHDAY
  POLICY
}

enum AnnouncementPriority {
  NORMAL
  HIGH
  URGENT
}

model Announcement {
  id             String               @id @default(cuid())
  organizationId String
  title          String
  body           String
  category       AnnouncementCategory @default(GENERAL)
  priority       AnnouncementPriority @default(NORMAL)
  audience       Audience             @default(ALL)
  departmentId   String?
  locationId     String?
  isPinned       Boolean              @default(false)
  publishAt      DateTime             @default(now())
  expiresAt      DateTime?
  authorId       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  reads       AnnouncementRead[]
  attachments AnnouncementAttachment[]

  @@index([organizationId, publishAt])
}

model AnnouncementAttachment {
  id             String   @id @default(cuid())
  announcementId String
  name           String
  fileKey        String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ─── Settings & Audit ─────────────────────────────────────────────────

model Setting {
  organizationId String
  key            String
  value          Json

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
}

/// Subject/body for system emails, editable from Settings. Keyed by a stable
/// template key; a missing or inactive row falls back to the built-in default
/// so a bad edit can never stop password reset from sending.
model EmailTemplate {
  organizationId String
  key            String
  subject        String
  bodyHtml       String
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entity         String
  entityId       String?
  meta           Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([organizationId, action])
  @@index([organizationId, actorId])
}

// ─── Payroll ──────────────────────────────────────────────────────────
//
// Money is Decimal(14,2) everywhere — never Float. A payslip, once
// calculated, is a snapshot: nothing on it is a live join, so it still
// reads true after the employee is promoted, transferred, or the salary
// structure behind it is edited.

enum PayComponentKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

/// Org-scoped catalogue of everything that can appear on a payslip line.
model PayComponent {
  id             String           @id @default(cuid())
  organizationId String
  code           String
  name           String
  kind           PayComponentKind
  /// Counts toward taxable income. Reimbursements and employer
  /// contributions do not.
  taxable        Boolean          @default(true)
  /// Computed by the statutory engine rather than the structure (PF/ESI/PT).
  isStatutory    Boolean          @default(false)
  /// Seeded and undeletable — the calculation engine references these codes.
  isSystem       Boolean          @default(false)
  order          Int              @default(0)
  active         Boolean          @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  structureLines StructureLine[]

  @@unique([organizationId, code])
  @@index([organizationId, kind])
}

enum SalaryCalcType {
  /// A fixed rupee amount.
  FLAT
  /// `value`% of the Basic component.
  PERCENT_OF_BASIC
  /// `value`% of monthly CTC.
  PERCENT_OF_CTC
  /// Left to the statutory engine (PF, ESI, PT).
  STATUTORY
  /// Whatever remains so the earnings sum to CTC. At most one per structure.
  BALANCE
}

model SalaryStructure {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  lines        StructureLine[]
  assignments  EmployeeSalary[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model StructureLine {
  id          String         @id @default(cuid())
  structureId String
  componentId String
  calcType    SalaryCalcType
  /// Percentage or rupee amount depending on calcType; ignored for
  /// STATUTORY and BALANCE.
  value       Decimal        @default(0) @db.Decimal(14, 2)
  order       Int            @default(0)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component PayComponent    @relation(fields: [componentId], references: [id])

  @@unique([structureId, componentId])
}

enum SalaryRevisionType {
  JOINING
  INCREMENT
  PROMOTION
  TRANSFER
  ADJUSTMENT
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
}

/// Effective-dated salary. This table *is* the revision history: the row
/// with the greatest effectiveFrom on or before a date is the salary as at
/// that date, and the row before it is the previous salary. A separate
/// history table would be free to disagree with the live value.
model EmployeeSalary {
  id            String             @id @default(cuid())
  employeeId    String
  structureId   String
  effectiveFrom DateTime           @db.Date
  monthlyCtc    Decimal            @db.Decimal(14, 2)
  /// Monthly TDS is entered rather than projected — real TDS needs annual
  /// projection, regime choice and investment proofs.
  monthlyTds    Decimal            @default(0) @db.Decimal(14, 2)
  revisionType  SalaryRevisionType @default(JOINING)
  reason        String?
  paymentMethod PaymentMethod      @default(BANK_TRANSFER)
  approvedById  String?
  createdAt     DateTime           @default(now())

  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure @relation(fields: [structureId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

enum PayrollRunStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  LOCKED
  PUBLISHED
  CANCELLED
}

model PayrollRun {
  id             String           @id @default(cuid())
  organizationId String
  /// "YYYY-MM", matching the month keys used across attendance.
  month          String
  status         PayrollRunStatus @default(DRAFT)
  payDate        DateTime?        @db.Date
  notes          String?

  calculatedAt   DateTime?
  calculatedById String?
  approvedAt     DateTime?
  approvedById   String?
  lockedAt       DateTime?
  lockedById     String?
  publishedAt    DateTime?
  publishedById  String?

  /// Denormalised so the runs list does not aggregate every payslip.
  /// Rewritten on every calculation; asserted against the payslips in tests.
  employeeCount      Int     @default(0)
  totalEarnings      Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions    Decimal @default(0) @db.Decimal(14, 2)
  totalEmployerCost  Decimal @default(0) @db.Decimal(14, 2)
  netPayable         Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  payslips     Payslip[]

  @@unique([organizationId, month])
  @@index([organizationId, status])
}

enum PayslipPaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Payslip {
  id             String @id @default(cuid())
  organizationId String
  runId          String
  employeeId     String

  /// Snapshot — deliberately duplicated rather than joined, so a payslip
  /// still reads correctly after the person is renamed, moved or promoted.
  employeeCode        String
  employeeName        String
  departmentName      String?
  designationName     String?
  structureName       String
  bankName            String?
  accountNumberMasked String?
  ifsc                String?

  workingDays Decimal @db.Decimal(5, 2)
  lopDays     Decimal @default(0) @db.Decimal(5, 2)
  payableDays Decimal @db.Decimal(5, 2)

  grossEarnings        Decimal @db.Decimal(14, 2)
  totalDeductions      Decimal @db.Decimal(14, 2)
  employerContribution Decimal @default(0) @db.Decimal(14, 2)
  netPay               Decimal @db.Decimal(14, 2)
  /// Set when deductions exceeded gross and were clamped; the remainder is
  /// carried rather than paying a negative salary.
  carriedShortfall     Decimal @default(0) @db.Decimal(14, 2)

  paymentStatus PayslipPaymentStatus @default(PENDING)
  paymentMethod PaymentMethod        @default(BANK_TRANSFER)
  paidAt        DateTime?
  paymentRef    String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run      PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayslipLine[]

  @@unique([runId, employeeId])
  @@index([employeeId, createdAt])
  @@index([organizationId, paymentStatus])
}

model PayslipLine {
  id            String           @id @default(cuid())
  payslipId     String
  componentCode String
  componentName String
  kind          PayComponentKind
  amount        Decimal          @db.Decimal(14, 2)
  order         Int              @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}
