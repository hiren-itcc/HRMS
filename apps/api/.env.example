# HRMS API — environment contract (validated at boot by src/config/env.ts;
# the app refuses to start on missing/invalid values)

NODE_ENV=development
PORT=4000

# Supabase Postgres — take the *Session pooler* string from the dashboard's
# Connect panel (port 5432). Not the direct connection: db.<ref>.supabase.co is
# IPv6-only without the IPv4 add-on. Not the transaction pooler (6543) either:
# it cannot run migrations, and this one URL serves both the app and Prisma
# Migrate.
#
# The two SSL parameters are not optional and not interchangeable:
#   - Drop them entirely and node-postgres connects in PLAINTEXT — salaries and
#     bank details in the clear. It does not warn you.
#   - `sslmode=require` alone FAILS here: pg v8 treats it as verify-full, and
#     Supabase's chain is not in the system trust store.
# So we pin Supabase's root CA. sslrootcert is relative to the process cwd,
# which is apps/api locally and /app in the container (see docker/api.Dockerfile).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./certs/supabase-ca.crt"

# Local Postgres from docker/compose.yaml, if you go back to it:
# DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms?schema=public"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

WEB_ORIGIN=http://localhost:5173

# File storage. With both SUPABASE_ variables set, uploaded documents go to
# Supabase Storage; without them they go to UPLOAD_DIR on local disk, which is
# fine for development and loses everything on any host that replaces its
# filesystem on deploy. The bucket must be PRIVATE — files are streamed through
# the API so its permission checks still apply.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key, not the anon key. Server-side only — it bypasses RLS.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Mail. Without RESEND_API_KEY the transport logs messages instead of sending
# them — the invite link is readable in the API log, which is enough for local
# work. MAIL_FROM must sit on a domain verified in Resend; the default sandbox
# sender only delivers to the address that owns the Resend account.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="HRMS <onboarding@resend.dev>"

# Seed bootstrap credentials (optional overrides)
# SEED_ADMIN_EMAIL=admin@hrms.local
# SEED_ADMIN_PASSWORD=ChangeMe-2026

# Password every newly created employee's sign-in starts with. Safe only
# because those accounts are flagged to force a change on first use — set
# your own per deployment regardless.
DEFAULT_USER_PASSWORD="Welcome@2026"

# Reverse proxies in front of the API. 0 = directly exposed (default).
# Only set this to the number of hops you actually have: Express reads
# X-Forwarded-For when it is non-zero, and that header is trivially forged —
# trusting it while directly exposed lets anyone choose the IP that the login
# rate limit counts against and that the audit log records.
TRUST_PROXY=0
